# ============================================================
# AI Research Agent — 环境变量配置
# 复制本文件为 .env 后按需修改： cp .env.example .env
# ============================================================

# ---- LLM 后端：deepseek | openai | ollama ----
LLM_PROVIDER=deepseek
# 不填则按 provider 取默认值：deepseek->deepseek-chat / openai->gpt-4o-mini / ollama->qwen2.5
LLM_MODEL=
# API key：deepseek 用 DEEPSEEK_API_KEY，openai 用 OPENAI_API_KEY，也可统一用 LLM_API_KEY
LLM_API_KEY=
# DeepSeek 走 OpenAI 兼容接口，默认 base_url 已内置；如需自定义可填：
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# ---- 向量化后端（用于 RAG 检索）：ollama | openai ----
# 推荐本地 Ollama 的 nomic-embed-text，免费且离线可用
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
# Ollama 服务地址（本地模型与本地向量化都走它）
OLLAMA_BASE_URL=http://localhost:11434

# ---- 知识库 & 文档 ----
# 源文档目录（构建知识库时读取）
DOCS_DIR=data/docs
# 向量库持久化路径（会被 git 忽略）
KB_PATH=.cache/kb

# ---- Agent 行为 ----
# 记忆窗口保留的对话轮数
MEMORY_K=6
# 每次检索返回的段落数
RETRIEVER_K=4
# 设为 true 可在终端打印 agent 思考/工具调用过程
# AGENT_VERBOSE=true
